    "sync:catalog": "tsx scripts/sync-catalog.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "hls.js": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "@playwright/test": "^1.56.0"
  }
}
