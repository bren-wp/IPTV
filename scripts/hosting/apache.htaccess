# IPTV static hosting (Apache / cPanel / DirectAdmin).
# Upload this file beside index.html. The app uses query-string channel
# links, so no URL rewrite rule or PHP dependency is needed.
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/vnd.apple.mpegurl .m3u8
  AddType audio/x-mpegurl .m3u
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # External broadcast streams and channel artwork require outbound HTTPS connections.
  # No remote scripts, frames, objects, or form submissions are permitted.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: blob:; connect-src 'self' https: http:; media-src 'self' https: http: blob:; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
  <FilesMatch "\.(json|m3u)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|png)$">
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
